        data_source=_text(
            state.data_source
        ),

        data_status=_text(
            metadata.get(
                "data_status",
                "UNKNOWN",
            )
        ),
    )


# ============================================================
# SAVE SIGNAL
# ============================================================

def append_signal(
    record: SignalRecord,
):
    """
    Salva uno snapshot nel journal.
    """

    file_exists = (
        FEEDBACK_FILE.exists()
    )

    with FEEDBACK_FILE.open(
        "a",
        newline="",
        encoding="utf-8",
    ) as file:

        writer = csv.DictWriter(
            file,
            fieldnames=FIELDS,
        )

        if not file_exists:

            writer.writeheader()

        writer.writerow(
            asdict(record)
        )


# ============================================================
# VALID GEOMETRY
# ============================================================

def _valid_geometry(
    record: SignalRecord,
):

    if record.entry is None:
        return False

    if record.stop is None:
        return False

    if record.direction not in {
        "LONG",
        "SHORT",
    }:
        return False

    return True


# ============================================================
# R MULTIPLE
# ============================================================

def _r_multiple(
    record: SignalRecord,
    price: float,
):

    if (
        record.entry is None
        or record.stop is None
    ):
        return None

    risk = abs(
        record.entry
        - record.stop
    )

    if risk <= 0:
        return None

    if record.direction == "LONG":

        return (
            price
            - record.entry
        ) / risk

    if record.direction == "SHORT":

        return (
            record.entry
            - price
        ) / risk

    return None


# ============================================================
# EVALUATE PRICE PATH
# ============================================================

def evaluate_path(
    record: SignalRecord,
    bars: Iterable[dict],
    timeout_bars: int = 288,
):
    """
    Valuta il percorso successivo
    al segnale.

    Ogni barra deve contenere:

        high
        low
        close

    Regola conservativa:

    se nello stesso candle vengono
    toccati SL e TP, consideriamo SL.

    Questo evita di attribuire un TP
    che il timeframe non consente
    di dimostrare con certezza.
    """

    if not _valid_geometry(
        record
    ):

        record.outcome = (
            OUTCOME_INVALID
        )

        return record

    bars = list(
        bars
    )

    if not bars:

        record.outcome = (
            OUTCOME_OPEN
        )

        return record

    entry = record.entry
    stop = record.stop

    mfe_price = entry
    mae_price = entry

    for index, bar in enumerate(
        bars[:timeout_bars],
        start=1,
    ):

        high = _float(
            bar.get("high")
        )

        low = _float(
            bar.get("low")
        )

        close = _float(
            bar.get("close")
        )

        if (
            high is None
            or low is None
        ):
            continue

        record.bars_held = index

        # ----------------------------------------------------
        # LONG
        # ----------------------------------------------------

        if record.direction == "LONG":

            mfe_price = max(
                mfe_price,
                high,
            )

            mae_price = min(
                mae_price,
                low,
            )

            hit_sl = (
                low <= stop
            )

            hit_tp3 = (
                record.tp3 is not None
                and high >= record.tp3
            )

            hit_tp2 = (
                record.tp2 is not None
                and high >= record.tp2
            )

            hit_tp1 = (
                record.tp1 is not None
                and high >= record.tp1
            )

        # ----------------------------------------------------
        # SHORT
        # ----------------------------------------------------

        else:

            mfe_price = min(
                mfe_price,
                low,
            )

            mae_price = max(
                mae_price,
                high,
            )

            hit_sl = (
                high >= stop
            )

            hit_tp3 = (
                record.tp3 is not None
                and low <= record.tp3
            )

            hit_tp2 = (
                record.tp2 is not None
                and low <= record.tp2
            )

            hit_tp1 = (
                record.tp1 is not None
                and low <= record.tp1
            )

        # ----------------------------------------------------
        # CONSERVATIVE PRIORITY
        # ----------------------------------------------------

        if hit_sl:

            record.outcome = (
                OUTCOME_SL
            )

            record.outcome_price = (
                stop
            )

            break

        if hit_tp3:

            record.outcome = (
                OUTCOME_TP3
            )

            record.outcome_price = (
                record.tp3
            )

            break

        if hit_tp2:

            record.outcome = (
                OUTCOME_TP2
            )

            record.outcome_price = (
                record.tp2
            )

            break

        if hit_tp1:

            record.outcome = (
                OUTCOME_TP1
            )

            record.outcome_price = (
                record.tp1
            )

            break

        # ----------------------------------------------------
        # TIMEOUT
        # ----------------------------------------------------

        if (
            index >= timeout_bars
            and close is not None
        ):

            record.outcome = (
                OUTCOME_TIMEOUT
            )

            record.outcome_price = (
                close
            )

    # --------------------------------------------------------
    # STILL OPEN AFTER PATH
    # --------------------------------------------------------

    if (
        record.outcome
        == OUTCOME_OPEN
    ):

        limit = min(
            len(bars),
            timeout_bars,
        )

        if limit > 0:

            last_close = _float(
                bars[
                    limit - 1
                ].get("close")
            )

            if last_close is not None:

                record.outcome = (
                    OUTCOME_TIMEOUT
                )

                record.outcome_price = (
                    last_close
                )

    # --------------------------------------------------------
    # MFE / MAE
    # --------------------------------------------------------

    record.mfe = _r_multiple(
        record,
        mfe_price,
    )

    record.mae = _r_multiple(
        record,
        mae_price,
    )

    # --------------------------------------------------------
    # FINAL R
    # --------------------------------------------------------

    if (
        record.outcome_price
        is not None
    ):

        record.r_multiple = (
            _r_multiple(
                record,
                record.outcome_price,
            )
        )

    return record


