# ============================================================

@dataclass
class SignalRecord:

    signal_id: str
    timestamp_utc: str

    commodity: str
    symbol: str
    direction: str

    entry: Optional[float]
    stop: Optional[float]
    tp1: Optional[float]
    tp2: Optional[float]
    tp3: Optional[float]

    probability: float
    quality: float
    confidence: float

    rr1: Optional[float]
    rr2: Optional[float]
    rr3: Optional[float]
    stop_atr: Optional[float]

    regime: str

    structure: str
    structure_direction: str

    setup: str
    setup_direction: str
    setup_quality: Optional[float]

    trigger: str
    trigger_direction: str
    trigger_confirmed: bool

    mtf_structure: str
    mtf_direction: str
    mtf_alignment: bool

    data_source: str
    data_status: str

    outcome: str = OUTCOME_OPEN
    outcome_price: Optional[float] = None

    mfe: Optional[float] = None
    mae: Optional[float] = None

    bars_held: int = 0

    r_multiple: Optional[float] = None


# ============================================================
# HELPERS
# ============================================================

def _value(
    value,
    default="",
):
    if value is None:
        return default

    return value


def _float(
    value,
):
    if value in (
        None,
        "",
        "None",
    ):
        return None

    try:
        return float(value)

    except (
        TypeError,
        ValueError,
    ):
        return None


def _bool(
    value,
):
    if isinstance(
        value,
        bool,
    ):
        return value

    return str(
        value
    ).strip().lower() in {
        "1",
        "true",
        "yes",
        "y",
    }


def _text(
    value,
):
    if value is None:
        return ""

    return str(value)


# ============================================================
# SIGNAL ID
# ============================================================

def make_signal_id(
    state,
    timestamp: Optional[str] = None,
):
    """
    Crea un ID stabile per il segnale.
    """

    if timestamp is None:

        timestamp = (
            datetime.now(
                timezone.utc
            ).isoformat()
        )

    raw = (
        f"{timestamp}|"
        f"{state.commodity}|"
        f"{state.symbol}|"
        f"{state.setup_direction}|"
        f"{state.entry}"
    )

    return hashlib.sha256(
        raw.encode(
            "utf-8"
        )
    ).hexdigest()[:16]


# ============================================================
# BUILD SIGNAL
# ============================================================

def build_signal_record(
    state,
    timestamp: Optional[str] = None,
):
    """
    Converte uno State Gagarin
    in uno snapshot del segnale.
    """

    if timestamp is None:

        timestamp = (
            datetime.now(
                timezone.utc
            ).isoformat()
        )

    metadata = (
        state.metadata
        if isinstance(
            state.metadata,
            dict,
        )
        else {}
    )

    return SignalRecord(

        signal_id=make_signal_id(
            state,
            timestamp,
        ),

        timestamp_utc=timestamp,

        commodity=_text(
            state.commodity
        ),

        symbol=_text(
            state.symbol
        ),

        direction=_text(
            state.setup_direction
        ),

        entry=_float(
            state.entry
        ),

        stop=_float(
            state.stop
        ),

        tp1=_float(
            state.tp1
        ),

        tp2=_float(
            state.tp2
        ),

        tp3=_float(
            state.tp3
        ),

        probability=float(
            _value(
                state.probability,
                0,
            )
        ),

        quality=float(
            _value(
                state.quality,
                0,
            )
        ),

        confidence=float(
            _value(
                state.confidence,
                0,
            )
        ),

        rr1=_float(
            state.rr1
        ),

        rr2=_float(
            state.rr2
        ),

        rr3=_float(
            state.rr3
        ),

        stop_atr=_float(
            state.stop_atr
        ),

        regime=_text(
            state.regime
        ),

        structure=_text(
            state.structure
        ),

        structure_direction=_text(
            state.structure_direction
        ),

        setup=_text(
            state.setup
        ),

        setup_direction=_text(
            state.setup_direction
        ),

        setup_quality=_float(
            state.setup_quality
        ),

        trigger=_text(
            state.trigger
        ),

        trigger_direction=_text(
            state.trigger_direction
        ),

        trigger_confirmed=bool(
            state.trigger_confirmed
        ),

        mtf_structure=_text(
            state.mtf_structure
        ),

        mtf_direction=_text(
            state.mtf_direction
        ),

        mtf_alignment=bool(
            state.mtf_alignment
