# ============================================================
# STATISTICS
# ============================================================

def summarize(
    records: Iterable[
        SignalRecord
    ],
):

    records = list(
        records
    )

    closed = [
        record
        for record in records
        if record.outcome
        not in {
            OUTCOME_OPEN,
            OUTCOME_INVALID,
        }
    ]

    wins = [
        record
        for record in closed
        if record.outcome
        in {
            OUTCOME_TP1,
            OUTCOME_TP2,
            OUTCOME_TP3,
        }
    ]

    losses = [
        record
        for record in closed
        if record.outcome
        == OUTCOME_SL
    ]

    r_values = [
        record.r_multiple
        for record in closed
        if record.r_multiple
        is not None
    ]

    avg_r = (
        sum(r_values)
        / len(r_values)
        if r_values
        else None
    )

    win_rate = (
        len(wins)
        / len(closed)
        * 100
        if closed
        else None
    )

    # --------------------------------------------------------
    # PER COMMODITY
    # --------------------------------------------------------

    by_commodity = defaultdict(
        lambda: {
            "signals": 0,
            "closed": 0,
            "wins": 0,
            "losses": 0,
            "r_values": [],
        }
    )

    for record in records:

        bucket = (
            by_commodity[
                record.commodity
            ]
        )

        bucket[
            "signals"
        ] += 1

        if record.outcome not in {
            OUTCOME_OPEN,
            OUTCOME_INVALID,
        }:

            bucket[
                "closed"
            ] += 1

        if record.outcome in {
            OUTCOME_TP1,
            OUTCOME_TP2,
            OUTCOME_TP3,
        }:

            bucket[
                "wins"
            ] += 1

        if (
            record.outcome
            == OUTCOME_SL
        ):

            bucket[
                "losses"
            ] += 1

        if record.r_multiple is not None:

            bucket[
                "r_values"
            ].append(
                record.r_multiple
            )

    commodity_stats = {}

    for (
        commodity,
        bucket,
    ) in by_commodity.items():

        values = bucket.pop(
            "r_values"
        )

        bucket[
            "avg_r"
        ] = (
            sum(values)
            / len(values)
            if values
            else None
        )

        bucket[
            "win_rate"
        ] = (
            bucket["wins"]
            / bucket["closed"]
            * 100
            if bucket["closed"]
            else None
        )

        commodity_stats[
            commodity
        ] = bucket

    return {
        "signals": len(
            records
        ),

        "closed": len(
            closed
        ),

        "open": sum(
            1
            for record in records
            if record.outcome
            == OUTCOME_OPEN
        ),

        "invalid": sum(
            1
            for record in records
            if record.outcome
            == OUTCOME_INVALID
        ),

        "wins": len(
            wins
        ),

        "losses": len(
            losses
        ),

        "win_rate": win_rate,

        "avg_r": avg_r,

        "outcomes": dict(
            Counter(
                record.outcome
                for record in records
            )
        ),

        "by_commodity":
            commodity_stats,
    }


# ============================================================
