# ============================================================

def format_summary(
    summary: dict,
):

    def fmt(
        value,
    ):

        if value is None:

            return "N/A"

        return f"{value:.2f}"

    lines = [

        "🧪 SOYUZ FEEDBACK",

        "━━━━━━━━━━━━━━━━━━━━",

        (
            f"Signals: "
            f"{summary['signals']}"
        ),

        (
            f"Closed: "
            f"{summary['closed']}"
        ),

        (
            f"Wins: "
            f"{summary['wins']}"
        ),

        (
            f"Losses: "
            f"{summary['losses']}"
        ),

        (
            f"Win rate: "
            f"{fmt(summary['win_rate'])}%"
        ),

        (
            f"Avg R: "
            f"{fmt(summary['avg_r'])}"
        ),
    ]

    return "\n".join(
        lines
    )