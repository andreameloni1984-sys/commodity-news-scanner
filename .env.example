# GAGARIN personal dashboard authentication.
# Configure these values in the hosting provider's Environment settings (Render:
# Dashboard -> gagarin-cloud -> Environment). Never commit generated values.
#
# Generate the password hash and a separate session-signing secret locally:
#   python - <<'PY'
#   import getpass, hashlib, secrets
#   password = getpass.getpass("Dashboard password: ")
#   rounds = 600_000
#   salt = secrets.token_bytes(16)
#   digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, rounds)
#   print(f"APP_PASSWORD_HASH=pbkdf2_sha256${rounds}${salt.hex()}${digest.hex()}")
#   print("APP_SESSION_SECRET=" + secrets.token_urlsafe(48))
#   PY
# The hash format is pbkdf2_sha256$rounds$salt_hex$digest_hex.
# cloud_api.py accepts 200000..2000000 PBKDF2 rounds; 600000 is the suggested
# starting value. APP_SESSION_SECRET must be a separate random secret.
# Paste the two generated values directly into the hosting Environment UI;
# do not put them in chat, source control, screenshots, or build logs.
APP_PASSWORD_HASH=
APP_SESSION_SECRET=

# API access for private dashboard endpoints. Generate a separate random key;
# do not reuse APP_SESSION_SECRET or the password hash.
CLOUD_API_KEY=

# GAGARIN execution — safe defaults
EXECUTION_ENABLED=0
EXECUTION_BROKER=paper
EXECUTION_DEFAULT_QUANTITY=1
PAPER_TRADING_ONLY=1

# IBKR Client Portal Gateway (only used when execution is explicitly enabled)
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_VERIFY_TLS=0
EXECUTION_TIMEOUT_SECONDS=15

# Trading 212 Demo API (Invest section only — PAPER/DEMO)
# Generate keys in Trading 212 app -> Settings -> API (Invest demo account)
# T212_API_KEY=
# T212_API_SECRET=
# T212_DEMO=1
